<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\Samples\**\*" CopyToOutputDirectory="PreserveNewest" Link="Samples\%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="..\Scripts\**\*" CopyToOutputDirectory="PreserveNewest" Link="Scripts\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="3.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\OpcodeRunner\OpcodeEngine\OpcodeEngine.csproj" />
  </ItemGroup>

</Project>
